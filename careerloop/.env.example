# ---------------------------------------------------------------------------
# CareerLoop environment variables
# Copy this file to ".env.local" and fill in the values you want.
# ---------------------------------------------------------------------------

# Required by Auth.js to sign session tokens. Generate one with:  npx auth secret
AUTH_SECRET=dev-only-change-me

# OAuth providers are OPTIONAL. Add the IDs/secrets for any you want enabled.
# Each provider's button only appears on the login page once it is configured.

# GitHub  (https://github.com/settings/developers)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Google  (https://console.cloud.google.com/apis/credentials)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Microsoft Entra ID  (https://entra.microsoft.com)
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
